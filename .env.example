# 复制为 .env 后填写。飞牛 Compose 若单独提供环境变量表，按同名填入即可。

# 32 字节随机数的 base64。生成：node scripts/gen-master-key.mjs 或 openssl rand -base64 32
# 丢了就解不开已保存的令牌，只能重新扫码。不要提交到 git。
MASTER_KEY=

# 控制台登录密码
ADMIN_TOKEN=

# 可选。POST /cron 的口令。留空则使用 ADMIN_TOKEN。
CRON_SECRET=

# 下面四项只在控制台还没保存过「定时」时生效。保存后以数据库 cron:config 为准。
# 1 开启定时；0 关闭。默认时间点是北京时间 08:10 与 10:20，可在控制台改成 1–8 个。
CRON_ENABLED=1
# 1：启动时补跑今天已过点但还没成功的轮次（补跑不等待抖动）
CRON_CATCHUP=1
# 只有到点触发的定时才会随机等待，单位秒，含两端。默认 0–900。
# 手动 POST /cron、控制台「全部签到」和启动补跑不等待。
CRON_JITTER_MIN_SEC=0
CRON_JITTER_MAX_SEC=900

# 构建镜像时的 npm 源。国内飞牛默认 npmmirror，可改成 https://registry.npmjs.org
NPM_REGISTRY=https://registry.npmmirror.com

# 通知的环境变量只在「页面里还没保存过配置」时当作默认值。
# 在控制台点过保存之后，以数据库里的加密配置为准。
TG_BOT_TOKEN=
TG_CHAT_ID=
# 可选。Telegram API 根地址，留给反代。留空则用 https://api.telegram.org
# 实际请求是 <TG_API_BASE>/bot<token>/sendMessage
TG_API_BASE=
QQ_APP_ID=
QQ_APP_SECRET=
QQ_OPENID=
QQ_SANDBOX=

# 国际版 Qoder 的设备通行证。不填的话，活动接口只有营销卡，没有「每天领 100 Credits」。
# 国内版账号不会使用这三项。也可以在控制台里按账号粘贴，不必写在这里。
# 在装了国际版 Qoder 的电脑上运行 runtime-info，环境参数是 3（国内版是 0）。
QODER_MACHINE_TOKEN=
QODER_MACHINE_CODE=
QODER_MACHINE_TYPE=
